# ── Google Cloud / Firestore ─────────────────────────────────────────────────
USE_FIRESTORE=false
GOOGLE_CLOUD_PROJECT=
FIREBASE_CREDENTIALS_JSON=

# ── Bootstrap ─────────────────────────────────────────────────────────────────
SETUP_CODE=

# ── Security / Sessions ───────────────────────────────────────────────────────
SESSION_SECRET=
SCHEDULER_SECRET=
COOKIE_SECURE=true

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
